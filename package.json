{
  "name": "cardtrello",
  "version": "2.0.0",
  "description": "Backend escalável para integração Trello com suporte a multi-usuários, autenticação JWT e SQLite Local",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:server": "node --watch src/server.js",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "lista": "node buscarLista.js"
  },
  "keywords": [
    "trello",
    "express",
    "sqlite",
    "jwt",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
