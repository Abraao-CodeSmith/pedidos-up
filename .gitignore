# ==========================================
# Ignorar arquivos do Git - Pedidos UP
# ==========================================

# 1. Dependências de pacotes
node_modules/
client/node_modules/

# 2. Arquivos de Ambiente e Chaves Secretas
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# 3. Banco de Dados Local (SQLite)
*.sqlite
*.sqlite-journal
*.db
database.sqlite

# 4. Arquivos de Compilação (Builds & Dist)
dist/
client/dist/
build/
.vite/
client/.vite/

# 5. Logs e Arquivos de Depuração
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Arquivos Temporários e do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 7. Configurações de IDE e Editores de Código
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
